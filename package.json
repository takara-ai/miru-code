{
  "name": "@takara-ai/miru-code",
  "version": "1.11.0",
  "mcpName": "ai.takara/miru",
  "description": "Miru (見る) — hybrid code search for agents. Bun, TypeScript, Takara embeddings.",
  "type": "module",
  "license": "MIT",
  "author": "Takara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takara-ai/miru-code.git"
  },
  "homepage": "https://takara.ai",
  "bugs": "https://github.com/takara-ai/miru-code/issues",
  "keywords": [
    "code-search",
    "semantic-search",
    "hybrid-search",
    "mcp",
    "embeddings",
    "bm25",
    "bun",
    "agents",
    "cursor",
    "takara"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "bin": {
    "miru": "./src/cli.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "grammars",
    "tokenizer",
    "docs",
    "scripts/install-git-hooks.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "miru": "bun run src/cli.ts",
    "mcp": "bun run src/cli.ts",
    "test": "bun test",
    "coverage": "bun test --coverage --coverage-reporter=lcov",
    "coverage:badge": "bun run coverage && bun run scripts/update-coverage-badge.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "bun run scripts/install-git-hooks.ts",
    "build:kiro-plugin": "bun run scripts/build-kiro-plugin.ts",
    "vendor-grammars": "bun run scripts/vendor-grammars.ts",
    "prepublishOnly": "bun run typecheck && bun test",
    "benchmark:ab": "bun run scripts/search-ab-local.ts",
    "benchmark:ab-multi": "bun run scripts/search-ab-multi.ts",
    "benchmark:codesearchnet-compression": "bun run scripts/benchmark-codesearchnet-compression.ts",
    "benchmark:codesearchnet-alpha": "bun run scripts/calibrate-codesearchnet-alpha.ts",
    "benchmark:ranking-sweep": "bun run scripts/sweep-ranking-configs.ts",
    "benchmark:ranking-factorial": "bun run scripts/sweep-ranking-factorial.ts",
    "benchmark:recall": "bun run scripts/benchmark-recall-tokens.ts",
    "benchmark:vs-grep": "bun run scripts/benchmark-miru-vs-grep.ts",
    "benchmark:workflow": "bun run scripts/benchmark-workflow-tokens.ts",
    "benchmark:literal": "bun run scripts/benchmark-literal-tokens.ts",
    "benchmark:quality": "bun run scripts/benchmark-quality.ts",
    "benchmark:quantization": "bun run scripts/benchmark-quantization.ts",
    "benchmark:tokenizer-ab": "bun run scripts/tokenizer-ab.ts",
    "sagemaker:auth-check": "bun run scripts/sagemaker-auth-check.ts",
    "sagemaker:create-invoke-user": "bun run scripts/create-sagemaker-invoke-user.ts",
    "benchmark:embedding-latency": "bun run scripts/embedding-latency-ab.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sagemaker-runtime": "^3.1090.0",
    "@aws-sdk/credential-provider-node": "^3.972.70",
    "ignore": "^7.0.5",
    "web-tree-sitter": "^0.26.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@derekstride/tree-sitter-sql": "^0.3.11",
    "@huggingface/tokenizers": "^0.1.3",
    "@tree-sitter-grammars/tree-sitter-svelte": "^1.0.2",
    "@types/bun": "^1.3.14",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tree-sitter-astro": "github:virchau13/tree-sitter-astro#213f6e6",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cli": "^0.27.0",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-dart": "^1.0.0",
    "tree-sitter-elixir": "^0.3.5",
    "tree-sitter-embedded-template": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-haskell": "^0.23.1",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-ocaml": "^0.24.2",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-solidity": "^1.2.13",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-vue": "github:tree-sitter-grammars/tree-sitter-vue#ce8011a",
    "typescript": "^6.0.3"
  }
}
