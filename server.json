{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.takara/miru",
  "description": "Hybrid semantic and keyword code search for coding agents.",
  "repository": {
    "url": "https://github.com/takara-ai/miru-code",
    "source": "github"
  },
  "websiteUrl": "https://takara.ai",
  "version": "1.10.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@takara-ai/miru-code",
      "version": "1.10.0",
      "runtimeHint": "bunx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "TAKARA_API_KEY",
          "description": "Takara API key. Optional: without it, the MCP auth tool signs in with a device code.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
